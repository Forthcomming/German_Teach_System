    private void Start()
    {
        // 涓篋ropdown鐨剉alueChange浜嬩欢娣诲姞鐩戝惉鍣�
        dropdown.onValueChanged.AddListener(delegate {
            ChangeAnimator();
        });
        m_InputWord.onEndEdit.AddListener(HandleEndEdit);
        // 纭�淇� exitPanel 鍒濆�嬩笉鍙�瑙�
        exitPanelCanvasGroup.alpha = 0;
        exitPanelCanvasGroup.blocksRaycasts = false;  // 鍒濆�嬫椂涓嶉樆鎸＄偣鍑�

    }
    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Escape))
        {
            ShowExitPanel(); // 浣跨敤娓愭樉鏂规硶鏄剧ず闈㈡澘
        }
        if (m_AudioSource.isPlaying == false && m_IsSpeaking)
        {
            m_IsSpeaking = false;
            SetAnimator("state", 0); // 鍒囨崲鍒伴潤姝㈢姸鎬�
        }
        /* 銆怢YF鏂板�炪€戞�€娴嬪綍闊宠嚜鍔ㄤ笂浼� */
        if(m_VoiceInputs.isAutoStopRecording){
            m_VoiceInputs.isAutoStopRecording = false;
            ToggleRecord();
        }
        // 銆怢YF鏂板�炪€戞挱鏀捐��闊虫椂锛屾樉绀烘殏鍋滄挱鏀炬寜閽�锛涘惁鍒欓殣钘忔寜閽�
        stopPlayAudioButton.gameObject.SetActive(isPlayingVoice);

    }
    private void HandleEndEdit(string text)
    {
        if (Input.GetKeyDown(KeyCode.Return) || Input.GetKeyDown(KeyCode.KeypadEnter))
        {
            SendData();
        }
    }
    public void OnConfirmExit()
    {
        Application.Quit(); // Quit the game
#if UNITY_EDITOR
        UnityEditor.EditorApplication.isPlaying = false; // Stop play mode in the editor
#endif
    }

    public void OnCancelExit()
    {
        HideExitPanel(); // 浣跨敤娓愰殣鏂规硶闅愯棌闈㈡澘
    }
    IEnumerator FadeElement(CanvasGroup canvasGroup, float targetAlpha, float duration)
    {
        float startAlpha = canvasGroup.alpha;
        float time = 0f;

        while (time < duration)
        {
            time += Time.unscaledDeltaTime;
            canvasGroup.alpha = Mathf.Lerp(startAlpha, targetAlpha, time / duration);
            yield return null;
        }

        canvasGroup.alpha = targetAlpha;

        // 鍦ㄦ笎鍙樼粨鏉熷悗鏇存柊 CanvasGroup 鐨� blocksRaycasts 灞炴€э紝浠ュ厑璁告垨闃绘�㈢偣鍑�
        canvasGroup.blocksRaycasts = targetAlpha > 0;
    }

    public void ShowExitPanel()
    {
        StartCoroutine(FadeElement(exitPanelCanvasGroup, 1.0f, 0.5f));  // 娓愭樉
        Time.timeScale = 0; // 鏆傚仠娓告垙
    }

    public void HideExitPanel()
    {
        StartCoroutine(FadeElement(exitPanelCanvasGroup, 0.0f, 0.5f));  // 娓愰殣
        Time.timeScale = 1; // 鎭㈠�嶆父鎴忔椂闂�
    }


    /// <summary>
