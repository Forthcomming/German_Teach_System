    /// <summary>
    /// 鍙戦€佷俊鎭�
    /// </summary>
    public void SendData()
    {
        if (m_InputWord.text.Equals(""))
            return;

        if (m_CreateVoiceMode)//鍚堟垚杈撳叆涓鸿��闊�
        {
            CallBack(m_InputWord.text);
            m_InputWord.text = "";
            return;
        }

        StartCoroutine(GetSendChatInfo(m_InputWord.text));
        //娣诲姞璁板綍鑱婂ぉ
        //m_ChatHistory.Add(m_InputWord.text);
        //鎻愮ず璇�
        string _msg = m_InputWord.text;

        //鍙戦€佹暟鎹�
        m_ChatSettings.m_ChatModel.PostMsg(_msg, CallBack);

        m_InputWord.text = "";
        m_TextBack.text = "姝ｅ湪鎬濊€冧腑...";

        //鍒囨崲鎬濊€冨姩浣�
        //SetAnimator("state", 1);
    }
    /// <summary>
    /// 甯︽枃瀛楀彂閫�
    /// </summary>
    /// <param name="_postWord"></param>
    public void SendData(string _postWord)
    {
        if (_postWord.Equals(""))
            return;

        if (m_CreateVoiceMode)//鍚堟垚杈撳叆涓鸿��闊�
        {
            CallBack(_postWord);
            m_InputWord.text = "";
            return;
        }

        StartCoroutine(GetSendChatInfo(_postWord));
        //娣诲姞璁板綍鑱婂ぉ
        //m_ChatHistory.Add(_postWord);
        //鎻愮ず璇�
        string _msg = _postWord;

        //鍙戦€佹暟鎹�
        m_ChatSettings.m_ChatModel.PostMsg(_msg, CallBack);

        m_InputWord.text = "";
        m_TextBack.text = "姝ｅ湪鎬濊€冧腑...";

        //鍒囨崲鎬濊€冨姩浣�
        //SetAnimator("state", 1);
    }

    /// <summary>
    /// AI鍥炲�嶇殑淇℃伅鐨勫洖璋�
    /// </summary>
    /// <param name="_response"></param>
    private void CallBack(string _response)
    {
        if (string.IsNullOrEmpty(_response))
            return;

        _response = _response.Trim();
        Debug.Log("鏀跺埌AI澧為噺鍥炲�嶏細" + _response);

        // 1. 鏃犺�轰粈涔堟ā寮忥紝鍏堣拷鍔犲埌鏄剧ず鏂囨湰
        AppendText(_response);

        // 2. 鎷兼帴鍒扮紦鍐插尯
        m_UnfinishedBuffer += _response;

        // 3. 妫€鏌ョ紦鍐插尯鏄�鍚﹀惈鏈夆€滃己鍋滈】鏍囩偣鈥�
        // 鍖呭惈锛氬彞鍙枫€佹劅鍙瑰彿銆侀棶鍙枫€佺渷鐣ュ彿銆佹垨鑰呮崲琛岀��
        if (ContainsStrongPunctuation(m_UnfinishedBuffer))
        {
            SendBufferToVoiceQueue();
        }

        // 4. 鍚�鍔ㄩ殢鏈哄姩鐢�
        if (!m_IsSpeaking)
        {
            m_IsSpeaking = true;
            StartSpeakingSequenceRandomly();
        }
    }

    /// <summary>
    /// 妫€鏌ュ瓧绗︿覆鏄�鍚﹀寘鍚�寮哄仠椤挎爣鐐�
    /// </summary>
    private bool ContainsStrongPunctuation(string text)
    {
        if (string.IsNullOrEmpty(text)) return false;

        // 瀹氫箟寮哄仠椤跨�﹀彿
        char[] strongPunctuations = { '銆�', '锛�', '锛�', '!', '?', '\n' };

        // 妫€鏌ユ槸鍚﹀寘鍚�涓婅堪瀛楃�︼紝鎴栬€呭寘鍚�鐪佺暐鍙�
        if (text.IndexOfAny(strongPunctuations) != -1 || text.Contains("鈥︹€�") || text.Contains("..."))
        {
            return true;
        }
        return false;
    }

    /// <summary>
    /// 灏嗗綋鍓嶇紦鍐插尯鍐呭�归€佸叆璇�闊抽槦鍒楀苟娓呯┖
    /// </summary>
    private void SendBufferToVoiceQueue()
    {
        string toSpeak = m_UnfinishedBuffer.Trim();
        if (string.IsNullOrEmpty(toSpeak)) return;

        // 銆愭墦鏂�閫昏緫銆戯細濡傛灉鏄�鏂扮殑涓€杞�瀵硅瘽鐨勭��涓€鍙�
        if (isNewInput)
        {
            isNewInput = false;
            StopPlayAudio();
            m_VoiceQueue.Clear(); // 娓呯┖鏃ч槦鍒楋紝闃叉�㈡柊鑰佸�硅瘽娣峰湪涓€璧�
        }

        // 鍔犲叆闃熷垪
        m_VoiceQueue.Enqueue(toSpeak);
        Debug.Log($"[寮烘爣鐐规柇鍙�] 鍔犲叆璇�闊抽槦鍒楋細{toSpeak}");

        // 娓呯┖缂撳瓨
        m_UnfinishedBuffer = string.Empty;

        // 灏濊瘯鎾�鏀�
        TryPlayNextVoice();
    }

    // 瀹氫箟鎺ユ敹瀹屾暣鍥炲�嶅弬鏁扮殑鏂规硶
    public IEnumerator ReceiveFullResponse(string fullResponse)
    {
        yield return new WaitForEndOfFrame();

        /* 銆怢YF鏂板�炪€戯細鎵撴柇AI涓婁竴娈佃��闊� */
        isNewInput = true;
        m_UnfinishedBuffer = "";

        ChatPrefab _receiveChat = Instantiate(m_RobotChatPrefab, m_rootTrans.transform);
        m_TempChatBox.Add(_receiveChat.gameObject);
        _receiveChat.SetText(fullResponse);
        //閲嶆柊璁＄畻瀹瑰櫒灏哄��
        LayoutRebuilder.ForceRebuildLayoutImmediate(m_rootTrans);
        StartCoroutine(TurnToLastLine());
    }
   

    private bool IsSentenceComplete(string text)
    {
        if (string.IsNullOrEmpty(text))
            return false;

        char lastChar = text[text.Length - 1];
        return lastChar == '銆�' || lastChar == '锛�' || lastChar == '锛�' || lastChar == '锛�' || lastChar == ' ' || char.IsPunctuation(lastChar);
    }
    private void TryPlayNextVoice()
    {
        // 銆怢YF鏂板�炪€戜紭鍖栫瓑寰匒I鎬濊€冩椂鐨刄I,姝ゅ�凙I宸茶繑鍥炶��闊虫秷鎭�
        m_VoiceBottonText.text = "鐐瑰嚮鎸夐挳锛屽紑濮嬪綍闊�"; 
        isLoadingAnswer = 2;
        m_RecordTips.text = "";
        m_VoiceInputBotton.interactable = true;

        // 濡傛灉宸茬粡鍦ㄦ挱鏀捐��闊筹紝鎴栬€呰��闊抽槦鍒椾负绌猴紝鍒欑洿鎺ヨ繑鍥�
        if (isPlayingVoice || m_VoiceQueue.Count == 0)
        {
            Debug.Log("褰撳墠娌℃湁闇€瑕佹挱鏀剧殑璇�闊虫垨姝ｅ湪鎾�鏀句腑...");
            return;
        }

        // 浠庨槦鍒椾腑鍙栧嚭涓嬩竴娈佃��闊�
        string nextVoice = m_VoiceQueue.Dequeue();
        string cleanVoice=CleanTextForTTS(nextVoice);
        // 銆愬叧閿�鏂板�炪€戯細妫€鏌ユ竻鐞嗗悗鐨勬枃鏈�鏄�鍚︿负绌�
        if (string.IsNullOrWhiteSpace(cleanVoice))
        {
            Debug.LogWarning("妫€娴嬪埌绌烘枃鏈�璇�闊筹紝璺宠繃骞跺皾璇曟挱鏀句笅涓€鏉�...");
            // 閫掑綊璋冪敤锛屽皾璇曟挱鏀鹃槦鍒椾腑鐨勪笅涓€涓�
            TryPlayNextVoice();
            return;
        }
        isPlayingVoice = true;

        Debug.Log($"寮€濮嬫挱鏀捐��闊筹細{cleanVoice}");

        // 璋冪敤璇�闊冲悎鎴愭挱鏀�
        //voiceCloneTTS.VoiceTTS(nextVoice,PlayVoice);
        //volcengineVoiceCloneTTS.VoiceTTS1(cleanVoice, PlayVoice);

        // 璋冪敤璇�闊冲悎鎴愭挱鏀�
        m_ChatSettings.m_TextToSpeech.Speak(cleanVoice, PlayVoice);
    }
    private string CleanTextForTTS(string input)
    {
        if (string.IsNullOrEmpty(input))
            return string.Empty;

        //// 1. 灏嗘墍鏈夌┖鐧藉瓧绗︼紙鎹㈣�屻€佸洖杞︺€佸埗琛ㄧ�︺€佸�氫綑绌烘牸锛夌粺涓€鏇挎崲涓轰竴涓�绌烘牸
        //// \s 鍖归厤 [ \f\n\r\t\v]锛岃繖鑳界洿鎺ュ�勭悊鎺夋墍鏈夊舰寮忕殑鈥滅┖琛屸€�
        //input = Regex.Replace(input, @"\s+", " ");

        // 2. 绉婚櫎鐗规畩瀛楃��
        // 淇濈暀锛氫腑鏂囥€佽嫳鏂囥€佹暟瀛椼€佸父鐢ㄤ腑鑻辨枃鏍囩偣
        input = Regex.Replace(
            input,
            @"[^a-zA-Z0-9\u4e00-\u9fa5锛屻€傦紒锛熴€�,.!? ""鈥溾€�: 锛歖+",
        ""
        );

        //// 3. 鍐嶆�＄‘淇濇病鏈夊洜涓虹壒娈婂瓧绗﹁��鍒犳帀鍚庣暀涓嬬殑鍙岀┖鏍�
        //input = Regex.Replace(input, @"\s{2,}", " ");

        return input.Trim();
    }

    /* 銆怢YF鏂板�炪€戜腑鏂�璇�闊虫挱鏀� */
    public void StopPlayAudio(){
        if(voicePlayWaitingCoroutine!=null){
            StopCoroutine(voicePlayWaitingCoroutine);
        }
        m_VoiceQueue.Clear();
        m_AudioSource.Stop();
        isPlayingVoice = false; // 鏍囪�板綋鍓嶆挱鏀剧粨鏉�
        StopSpeakingSequence(); // 鍋滄�㈠綋鍓嶅姩鐢诲苟鍒囨崲鍒伴潤姝㈢姸鎬�
    }

    private void AppendText(string _response)
    {
        if (string.IsNullOrEmpty(_response))
            return;

        // 澧為噺杩藉姞鍒版樉绀烘枃鏈�
        m_TextBack.text += _response;
        Debug.Log("m_TextBack.text"+m_TextBack.text);
        // 濡傛灉閫愬瓧鏄剧ず鏈�瀹屾垚锛屽垯缁х画閫愬瓧鏄剧ず
        if (!m_WriteState)
        {
            StartTypeWords(m_TextBack.text);
        }
    }

