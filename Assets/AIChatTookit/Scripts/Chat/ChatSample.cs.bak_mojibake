    private void Awake()
    {
        titleToType.text = titleToSync.text;
        m_CommitMsgBtn.onClick.AddListener(delegate { SendData(); });
        m_SaveSettingBtn.onClick.AddListener(delegate { SaveSetting(); });
        RegistButtonEvent();
