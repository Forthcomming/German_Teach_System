root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{shader,hlsl,compute,cginc}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{json,md,yml,yaml,txt}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
